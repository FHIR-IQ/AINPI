{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/admin/weekly-report",
      "schedule": "12 14 * * 4"
    },
    {
      "path": "/api/v1/admin/marketplace-installs-poll",
      "schedule": "17 14 * * *"
    },
    {
      "path": "/api/v1/admin/suppression-confirm",
      "schedule": "41 15 * * *"
    }
  ]
}
