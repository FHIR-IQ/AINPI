{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainpi.dev/api/v1/schemas/networks.schema.json",
  "title": "AINPI health data networks guide",
  "description": "Use cases, the routes data can take for each, and the networks that carry those routes, by state. Every network and route cites at least one primary source.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "enum": [
              "treatment-records",
              "individual-access",
              "find-endpoint",
              "payer-exchange",
              "encounter-alerts",
              "public-health",
              "community-referral"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "ainpi_links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string"
                },
                "finding_slug": {
                  "type": "string"
                }
              },
              "required": [
                "label"
              ]
            }
          }
        },
        "required": [
          "slug",
          "label",
          "summary",
          "ainpi_links"
        ]
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "use_case": {
            "enum": [
              "treatment-records",
              "individual-access",
              "find-endpoint",
              "payer-exchange",
              "encounter-alerts",
              "public-health",
              "community-referral"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "who_can_use": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "standard": {
            "type": "string",
            "minLength": 1
          },
          "how_to_join": {
            "type": "string",
            "minLength": 1
          },
          "network_types": {
            "type": "array",
            "items": {
              "enum": [
                "state_hie",
                "multi_state",
                "qhin",
                "vendor_network",
                "payer_api",
                "direct"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "primary": {
                  "type": "boolean"
                }
              },
              "required": [
                "url",
                "title",
                "accessed",
                "primary"
              ]
            }
          },
          "ainpi_links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string"
                },
                "finding_slug": {
                  "type": "string"
                }
              },
              "required": [
                "label"
              ]
            }
          }
        },
        "required": [
          "id",
          "use_case",
          "title",
          "summary",
          "who_can_use",
          "rule",
          "standard",
          "how_to_join",
          "network_types",
          "sources",
          "ainpi_links"
        ]
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "state_hie",
              "multi_state",
              "qhin",
              "vendor_network",
              "payer_api",
              "direct"
            ]
          },
          "national": {
            "type": "boolean"
          },
          "states": {
            "type": "array",
            "items": {
              "enum": [
                "AL",
                "AK",
                "AZ",
                "AR",
                "CA",
                "CO",
                "CT",
                "DE",
                "DC",
                "FL",
                "GA",
                "HI",
                "ID",
                "IL",
                "IN",
                "IA",
                "KS",
                "KY",
                "LA",
                "ME",
                "MD",
                "MA",
                "MI",
                "MN",
                "MS",
                "MO",
                "MT",
                "NE",
                "NV",
                "NH",
                "NJ",
                "NM",
                "NY",
                "NC",
                "ND",
                "OH",
                "OK",
                "OR",
                "PA",
                "RI",
                "SC",
                "SD",
                "TN",
                "TX",
                "UT",
                "VT",
                "VA",
                "WA",
                "WV",
                "WI",
                "WY"
              ]
            }
          },
          "detail_level": {
            "enum": [
              "basic",
              "full"
            ]
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "website": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "how_to_join": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "accessed": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "primary": {
                  "type": "boolean"
                }
              },
              "required": [
                "url",
                "title",
                "accessed",
                "primary"
              ]
            }
          },
          "last_checked": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "national",
          "states",
          "detail_level",
          "routes",
          "website",
          "how_to_join",
          "sources",
          "last_checked"
        ]
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "term",
          "definition"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "use_cases",
    "routes",
    "networks",
    "glossary"
  ]
}
