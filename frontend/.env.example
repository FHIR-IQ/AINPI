# Vercel Postgres Environment Variables
# When you connect Vercel Postgres, these are automatically populated

# Connection pooling URL (recommended for serverless functions)
POSTGRES_PRISMA_URL=""

# Direct connection URL (for migrations and Prisma Studio)  
POSTGRES_URL_NON_POOLING=""

# Standard Postgres URL (fallback)
DATABASE_URL=""

# How to get these values:
# 1. Create a Vercel project: vercel
# 2. Go to Vercel Dashboard > Storage > Create Database > Postgres
# 3. Connect to your project
# 4. Copy the environment variables to your .env.local file
# 5. For local development, pull env vars: vercel env pull .env.local

# NPI removal requests (src/lib/suppression.ts). The list lives in the
# npi_suppressions table; this optional override is merged on top for local
# runs. Comma-separated 10-digit NPIs. Never commit a real value.
# SUPPRESSED_NPIS=
# Removal inbox webhook (/api/v1/privacy/remove-inbound). Its own signing secret; no fallback.
# RESEND_REMOVAL_WEBHOOK_SECRET=whsec_...
# REMOVAL_INBOX=remove@ainpi.dev
# REMOVAL_FROM_ADDRESS="AINPI <no-reply@ainpi.dev>"
# SUPPRESSION_DAILY_CAP=10   # new requests processed automatically per UTC day; the rest are held
# REMOVAL_DAILY_CEILING=100  # removal form posts + emails accepted per UTC day, all callers; one admin alert when reached
